# Non-secret Tauri build state, committed to the repo so multiple
# machines / collaborators stay in sync. Don't put secrets here —
# secret values belong in `.env.tauri` (which IS gitignored).

# Android Play Store versionCode. Auto-incremented by
# `scripts/bump-android-version-code.mjs` after every successful
# `pnpm tauri:build-android-apk` / `tauri:build-android-aab`. Read by
# `src-tauri/gen/android/app/build.gradle.kts` via System.getenv() so
# the value here actually overrides tauri.properties' autogenerated
# versionCode (which Tauri derives as `major*1_000_000 + minor*1_000 +
# patch` from tauri.conf.json's `version`).
#
# Bumped to 1_000_010 because Tauri's autogenerated formula already
# produced 1_000_000 for v1.0.0 and that code has been claimed on the
# Play track. Play enforces a permanent monotonic floor across the
# whole track history (even retired releases), so future bumps must
# keep climbing — never reset.
ANDROID_VERSION_CODE=1000020