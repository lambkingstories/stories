{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LambKing Stories",
  "version": "1.0.0",
  "identifier": "com.stories.lambking",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build-only"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "LambKing Stories",
        "url": "index.html",
        "width": 414,
        "height": 896,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "16.0",
      "bundleVersion": "2"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
